<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmotionBooks - Minha Biblioteca</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/biblioteca.css">
    <script src="/js/logout.js" defer></script>

</head>
<body>

    <%- include('partials/navbar', { logado: logado }) %>

    <div class="container biblioteca-wrapper">
        <div class="header-biblioteca">
            <div>
                <h2>Minha Biblioteca</h2>
                <p>Gerencie suas leituras e favoritos</p>
            </div>
        </div>

        <div class="biblioteca-controles">
            <input type="text" id="buscaLivro" class="input-busca" placeholder="🔍 Buscar por título ou autor..." onkeyup="aplicarFiltros()" aria-label="Buscar livros por título ou autor">
            
            <div class="filtros-botoes" role="tablist" aria-label="Filtros de livros">
                <button class="btn-filtro ativo" onclick="mudarFiltro('Todos', this)" role="tab" aria-selected="true">Todos</button>
                <button class="btn-filtro" onclick="mudarFiltro('Lido', this)" role="tab" aria-selected="false">Lidos</button>
                <button class="btn-filtro" onclick="mudarFiltro('Quero ler', this)" role="tab" aria-selected="false">Quero Ler</button>
                <button class="btn-filtro" onclick="mudarFiltro('Favorito', this)" role="tab" aria-selected="false">❤️ Favoritos</button>
            </div>
        </div>

        <div id="listaBiblioteca" role="list" aria-label="Lista de livros da biblioteca">
            <p style="text-align: center; color: #888;">Carregando seus livros...</p>
        </div>
    </div>

    <!-- ACESSIBILIDADE -->
    <button class="btn-acessibilidade-flutuante" onclick="toggleMenuAcessibilidade()" title="Acessibilidade" aria-label="Abrir menu de acessibilidade">♿</button>

    <div class="menu-acessibilidade" id="menuAcessibilidade" role="dialog" aria-label="Menu de acessibilidade">
        <h3>Navegação</h3>
        <p class="text-desc">Personalize a experiência para deixar a leitura mais confortável.</p>

        <div class="acessibilidade-item">
            <span>Tamanho da fonte</span>
            <div>
                <button onclick="alterarFonte(-1)" aria-label="Diminuir fonte">A-</button>
                <button onclick="alterarFonte(1)" aria-label="Aumentar fonte">A+</button>
            </div>
        </div>

        <div class="acessibilidade-item">
            <span>Alto contraste</span>
            <button onclick="toggleContraste()" aria-label="Ativar ou desativar alto contraste">Ligar/Desligar</button>
        </div>
    </div>
    <%- include('partials/footer') %>
    <script>
        /* =====================================
           ACESSIBILIDADE
        ===================================== */
        function toggleMenuAcessibilidade() {
            const menu = document.getElementById('menuAcessibilidade');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleContraste() {
            document.body.classList.toggle('alto-contraste');
        }

        let tamanhoAtual = 100;

        function alterarFonte(direcao) {
            if (direcao > 0 && tamanhoAtual < 130) tamanhoAtual += 10;
            else if (direcao < 0 && tamanhoAtual > 80) tamanhoAtual -= 10;

            document.documentElement.style.fontSize = tamanhoAtual + '%';
            document.body.style.fontSize = tamanhoAtual + '%';
        }


        /* =====================================
           BIBLIOTECA
        ===================================== */
        let todosOsLivros = [];
        let filtroAtual = 'Todos';

        window.addEventListener('DOMContentLoaded', carregarBiblioteca);

        async function carregarBiblioteca() {
            try {
                const response = await fetch('/minha-biblioteca');
                if (response.status === 401) {
                    window.location.href = '/login';
                    return;
                }

                const data = await response.json();
                todosOsLivros = data.livros;
                aplicarFiltros();

            } catch (error) {
                console.error("Erro ao carregar:", error);
                document.getElementById('listaBiblioteca').innerHTML = `
                    <p style="text-align: center; color: #a34a4a;">Erro ao carregar livros. Tente novamente.</p>
                `;
            }
        }

        function mudarFiltro(novoFiltro, botaoClicado) {
            filtroAtual = novoFiltro;

            document.querySelectorAll('.btn-filtro').forEach(btn => {
                btn.classList.remove('ativo');
                btn.setAttribute('aria-selected', 'false');
            });
            botaoClicado.classList.add('ativo');
            botaoClicado.setAttribute('aria-selected', 'true');

            aplicarFiltros();
        }

        function aplicarFiltros() {
            const termoBusca = document.getElementById('buscaLivro').value.toLowerCase();
            const container = document.getElementById('listaBiblioteca');

            const livrosFiltrados = todosOsLivros.filter(livro => {
                const bateuTexto = livro.titulo.toLowerCase().includes(termoBusca) || livro.autor.toLowerCase().includes(termoBusca);

                let bateuFiltro = true;
                if (filtroAtual === 'Lido') bateuFiltro = livro.status_leitura === 'Lido';
                if (filtroAtual === 'Quero ler') bateuFiltro = livro.status_leitura === 'Quero ler';
                if (filtroAtual === 'Favorito') bateuFiltro = livro.favorito === 1;

                return bateuTexto && bateuFiltro;
            });

            desenharLivros(livrosFiltrados, container);
        }

        function desenharLivros(livros, container) {
            container.innerHTML = '';

            if (livros.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📚</div>
                        <h3>Nenhum livro encontrado</h3>
                        <p>Tente ajustar os filtros ou a busca.</p>
                    </div>
                `;
                return;
            }

            livros.forEach(livro => {
                const ehFavorito = livro.favorito === 1;
                const ehLido = livro.status_leitura === 'Lido';
                const div = document.createElement('div');
                div.className = 'livro-item';
                div.setAttribute('role', 'listitem');
                div.setAttribute('data-livro-id', livro.id_livro); 

                let capaLimpa = livro.capa_url;
                if (capaLimpa && capaLimpa.includes('](')) {
                    capaLimpa = capaLimpa.split('(')[1].replace(')', '');
                }

                // Botão de "promover para Lido" — só quando está em "Quero ler"
                const botaoLidoHtml = !ehLido
                    ? `<button class="btn-acao-rapida btn-lido-rapido" onclick="marcarComoLido(${livro.id_livro})" title="Marcar como Lido" aria-label="Marcar ${livro.titulo} como lido">✓</button>`
                    : `<button class="btn-acao-rapida btn-desmarcar-lido" onclick="desmarcarLido(${livro.id_livro}, ${ehFavorito})" title="Desmarcar Lido" aria-label="Desmarcar ${livro.titulo} como lido">↺</button>`;

                div.innerHTML = `
    <img src="${capaLimpa || '/img/placeholder.jpg'}" alt="Capa do livro ${livro.titulo}" class="livro-capa" onerror="this.src='/img/placeholder.jpg'">

    <div class="livro-info">
        <h4>${livro.titulo}</h4>
        <p>${livro.autor}</p>
        <div class="livro-info-extra">
            <span class="status-badge ${ehLido ? 'status-lido' : 'status-quero-ler'}">${livro.status_leitura}</span>
            ${ehFavorito ? '<span class="status-badge status-favorito">❤️ Favorito</span>' : ''}
            ${livro.link_leitura ? `<a href="#" onclick="abrirLeitura('${livro.link_leitura.replace(/'/g, "\\'")}', '${livro.titulo.replace(/'/g, "\\'")}'); return false;" class="livro-link-leitura">Ler agora ↗</a>` : ''}
        </div>
    </div>

    <div class="livro-acoes">
        ${botaoLidoHtml}
        <button class="btn-acao-rapida btn-heart-rapido ${ehFavorito ? 'ativo' : ''}" onclick="alternarFavoritoBiblioteca(${livro.id_livro}, ${!ehFavorito}, ${ehLido})" title="${ehFavorito ? 'Remover dos favoritos' : 'Adicionar aos favoritos'}" aria-label="${ehFavorito ? 'Remover' : 'Adicionar'} ${livro.titulo} dos favoritos">
            ${ehFavorito ? '❤️' : '🤍'}
        </button>
        <button class="btn-acao-rapida btn-remover" onclick="removerLivro(${livro.id_livro}, '${livro.titulo.replace(/'/g, "\\'")}')" title="Remover da biblioteca" aria-label="Remover ${livro.titulo} da biblioteca">🗑️</button>
    </div>
`;
                
                container.appendChild(div);
            });
        }

/* =====================================
   ABRIR LEITURA EXTERNA (Project Gutenberg)
===================================== */
async function abrirLeitura(link, titulo) {
    if (!link || link.trim() === "" || link === "null" || link === "undefined") {
        Swal.fire({
            title: 'Link indisponível',
            text: 'O link de leitura não está disponível para este livro.',
            icon: 'info',
            confirmButtonColor: '#8a6a47'
        });
        return;
    }

    const r = await Swal.fire({
        title: 'Sair do EmotionBooks?',
        text: 'Você será direcionado ao Project Gutenberg (site externo) para ler o livro.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sim, ir para o Gutenberg',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#8a6a47',
        cancelButtonColor: '#b0a89e',
        reverseButtons: true
    });

    if (r.isConfirmed) {
        window.open(link, '_blank');
    }
}
        /* =====================================
           AÇÃO: MARCAR COMO LIDO
        ===================================== */
    async function marcarComoLido(idLivro) {
    const card = document.querySelector(`[data-livro-id="${idLivro}"]`);
    if (!card) return;

    const btnLido = card.querySelector('.btn-lido-rapido');
    const badgeStatus = card.querySelector('.status-quero-ler');

    // ==== ATUALIZAÇÃO OTIMISTA ====
    if (btnLido) {
        btnLido.className = 'btn-acao-rapida btn-desmarcar-lido';
        btnLido.innerHTML = '↺';
        btnLido.setAttribute('onclick', `desmarcarLido(${idLivro}, false)`);
        btnLido.setAttribute('title', 'Desmarcar Lido');
        btnLido.disabled = true;
    }
    if (badgeStatus) {
        badgeStatus.className = 'status-badge status-lido';
        badgeStatus.textContent = 'Lido';
    }

    try {
        const response = await fetch('/marcar-lido', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_livro: idLivro })
        });
        if (!response.ok) throw new Error("Erro");

        // Sincroniza o estado global
        const livro = todosOsLivros.find(l => l.id_livro === idLivro);
        if (livro) livro.status_leitura = 'Lido';

        if (btnLido) btnLido.disabled = false;

    } catch (error) {
        // Reverter
        if (btnLido) {
            btnLido.className = 'btn-acao-rapida btn-lido-rapido';
            btnLido.innerHTML = '✓';
            btnLido.setAttribute('onclick', `marcarComoLido(${idLivro})`);
            btnLido.disabled = false;
        }
        if (badgeStatus) {
            badgeStatus.className = 'status-badge status-quero-ler';
            badgeStatus.textContent = 'Quero ler';
        }
        console.error("Erro:", error);
    }
}

        /* =====================================
           AÇÃO: DESMARCAR LIDO
           Se tem favorito, avisa que vai perder os dois
        ===================================== */
      async function desmarcarLido(idLivro, ehFavorito) {
    // Se tem favorito, avisa (usuário perde duas coisas de uma vez)
    if (ehFavorito) {
        const r = await Swal.fire({
            title: 'Desmarcar "Lido"?',
            text: 'Este livro também será removido dos favoritos.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sim, remover tudo',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#8b7355',
            cancelButtonColor: '#b0a89e',
            reverseButtons: true
        });
        if (!r.isConfirmed) return;
    }

    const card = document.querySelector(`[data-livro-id="${idLivro}"]`);
    if (!card) return;

    const btnLido = card.querySelector('.btn-desmarcar-lido');
    const btnHeart = card.querySelector('.btn-heart-rapido');
    const badgeStatus = card.querySelector('.status-lido');
    const badgeFav = card.querySelector('.status-favorito');

    // ==== ATUALIZAÇÃO OTIMISTA ====
    if (btnLido) {
        btnLido.className = 'btn-acao-rapida btn-lido-rapido';
        btnLido.innerHTML = '✓';
        btnLido.setAttribute('onclick', `marcarComoLido(${idLivro})`);
        btnLido.setAttribute('title', 'Marcar como Lido');
        btnLido.disabled = true;
    }
    if (badgeStatus) {
        badgeStatus.className = 'status-badge status-quero-ler';
        badgeStatus.textContent = 'Quero ler';
    }
    if (ehFavorito) {
        if (btnHeart) {
            btnHeart.innerHTML = '🤍';
            btnHeart.classList.remove('ativo');
        }
        if (badgeFav) badgeFav.remove();
    }

    try {
        const response = await fetch('/marcar-lido', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_livro: idLivro })
        });
        if (!response.ok) throw new Error("Erro");

        const data = await response.json();

        // Sincroniza estado global
        const livro = todosOsLivros.find(l => l.id_livro === idLivro);
        if (livro) {
            livro.status_leitura = 'Quero ler';
            if (data.removeuFavorito) livro.favorito = 0;
        }

        if (btnLido) btnLido.disabled = false;

        // Swal só se perdeu favorito junto (evento surpreendente)
        if (data.removeuFavorito) {
            Swal.fire({
                title: 'Removido',
                text: 'Livro e favorito removidos.',
                icon: 'info',
                confirmButtonColor: '#8b7355',
                timer: 1500,
                timerProgressBar: true
            });
        }

    } catch (error) {
        // Reverter tudo
        if (btnLido) {
            btnLido.className = 'btn-acao-rapida btn-desmarcar-lido';
            btnLido.innerHTML = '↺';
            btnLido.setAttribute('onclick', `desmarcarLido(${idLivro}, ${ehFavorito})`);
            btnLido.disabled = false;
        }
        if (badgeStatus) {
            badgeStatus.className = 'status-badge status-lido';
            badgeStatus.textContent = 'Lido';
        }
        if (ehFavorito) {
            if (btnHeart) {
                btnHeart.innerHTML = '❤️';
                btnHeart.classList.add('ativo');
            }
            const livroInfo = card.querySelector('.livro-info');
            if (livroInfo && !livroInfo.querySelector('.status-favorito')) {
                const novaBadge = document.createElement('span');
                novaBadge.className = 'status-badge status-favorito';
                novaBadge.textContent = '❤️ Favorito';
                livroInfo.appendChild(novaBadge);
            }
        }
        Swal.fire({
            title: 'Ops!',
            text: 'Não foi possível salvar. Tente novamente.',
            icon: 'error',
            confirmButtonColor: '#8b7355'
        });
        console.error("Erro:", error);
    }
}
        /* =====================================
           AÇÃO: FAVORITAR
           Se o livro não está Lido, avisa que vai marcar como Lido também
        ===================================== */
   async function alternarFavoritoBiblioteca(idLivro, novoStatus, jaEstaLido) {
// ==== Lê o estado REAL do card (não confia no parâmetro antigo) ====
    const card = document.querySelector(`[data-livro-id="${idLivro}"]`);
    if (!card) return;

    const btnHeart = card.querySelector('.btn-heart-rapido');
    const btnLido = card.querySelector('.btn-lido-rapido, .btn-desmarcar-lido');

    const jaEstaLido = !!card.querySelector('.status-lido');
    const estaFavoritado = btnHeart.classList.contains('ativo');
    const novoStatus = !estaFavoritado;

    // ==== FAVORITAR sem estar Lido → pergunta antes ====
    
    if (novoStatus && !jaEstaLido) {
        const r = await Swal.fire({
            title: 'Favoritar este livro?',
            text: 'Favoritos são livros que você já leu. Deseja marcar como lido também?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sim, favoritar e marcar como lido',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#8b7355',
            cancelButtonColor: '#b0a89e',
            reverseButtons: true
        });
        if (!r.isConfirmed) return;
    }



    // ==== ATUALIZAÇÃO OTIMISTA — muda a tela NA HORA ====
    btnHeart.innerHTML = novoStatus ? '❤️' : '🤍';
    btnHeart.classList.toggle('ativo', novoStatus);
 

    // Se favoritou e não estava Lido, marca Lido visualmente também
    if (novoStatus && !jaEstaLido) {
        // Troca o botão "✓" para "↺"
        if (btnLido) {
            btnLido.className = 'btn-acao-rapida btn-desmarcar-lido';
            btnLido.innerHTML = '↺';
            btnLido.setAttribute('onclick', `desmarcarLido(${idLivro}, true)`);
        }
        // Atualiza o badge de status
        const badgeStatus = card.querySelector('.status-badge.status-quero-ler');
        if (badgeStatus) {
            badgeStatus.className = 'status-badge status-lido';
            badgeStatus.textContent = 'Lido';
        }
        // Adiciona badge de favorito se não existir
        const livroInfo = card.querySelector('.livro-info');
        if (livroInfo && !livroInfo.querySelector('.status-favorito')) {
            const badgeFav = document.createElement('span');
            badgeFav.className = 'status-badge status-favorito';
            badgeFav.textContent = '❤️ Favorito';
            livroInfo.appendChild(badgeFav);
        }
   } else if (!novoStatus) {
    // Desfavoritou 
    const badgeFav = card.querySelector('.status-favorito');
    if (badgeFav) badgeFav.remove();

    // Desativa o botão do coração
    if (btnHeart) {
        btnHeart.innerHTML = '🤍';
        btnHeart.classList.remove('ativo');
    }
}
    // ==== Sincroniza com o servidor em paralelo ====
    try {
        const response = await fetch('/favoritar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id_livro: idLivro, favorito: novoStatus })
        });

        if (!response.ok) throw new Error("Erro no servidor");

        // Sincroniza o estado global (sem re-renderizar)
        const livro = todosOsLivros.find(l => l.id_livro === idLivro);
        if (livro) {
            livro.favorito = novoStatus ? 1 : 0;
            if (novoStatus && !jaEstaLido) {
                livro.status_leitura = 'Lido';
            }
        }

     

        // Se favoritou e marcou como Lido junto, mostra feedback
        if (novoStatus && !jaEstaLido) {
            Swal.fire({
                title: 'Salvo!',
                text: 'Livro marcado como Lido e adicionado aos Favoritos.',
                icon: 'success',
                confirmButtonColor: '#8b7355',
                timer: 2000,
                timerProgressBar: true
            });
        }

    } catch (error) {
        // ==== REVERTER — o servidor falhou, desfaz o que fizemos visualmente ====
        btnHeart.innerHTML = jaEstaLido || !novoStatus ? (novoStatus ? '🤍' : '❤️') : '🤍';
        btnHeart.classList.toggle('ativo', !novoStatus);
       

        // Reverte status se mudou
        if (novoStatus && !jaEstaLido) {
            const badgeStatus = card.querySelector('.status-badge.status-lido');
            if (badgeStatus) {
                badgeStatus.className = 'status-badge status-quero-ler';
                badgeStatus.textContent = 'Quero ler';
            }
            if (btnLido) {
                btnLido.className = 'btn-acao-rapida btn-lido-rapido';
                btnLido.innerHTML = '✓';
                btnLido.setAttribute('onclick', `marcarComoLido(${idLivro})`);
            }
        }
        if (!novoStatus) {
            const livroInfo = card.querySelector('.livro-info');
            if (livroInfo && !livroInfo.querySelector('.status-favorito')) {
                const badgeFav = document.createElement('span');
                badgeFav.className = 'status-badge status-favorito';
                badgeFav.textContent = '❤️ Favorito';
                livroInfo.appendChild(badgeFav);
            }
        }

        Swal.fire({
            title: 'Ops!',
            text: 'Não foi possível salvar. Tente novamente.',
            icon: 'error',
            confirmButtonColor: '#8b7355'
        });
        console.error("Erro:", error);
    }
}
        /* =====================================
           AÇÃO: REMOVER DA BIBLIOTECA
        ===================================== */
        async function removerLivro(idLivro, titulo) {
            const r = await Swal.fire({
                title: 'Remover livro?',
                html: `"<strong>${titulo}</strong>" será removido da sua biblioteca.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sim, remover',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#8b7355',
                cancelButtonColor: '#b0a89e',
                reverseButtons: true
            });
            if (!r.isConfirmed) return;

            try {
                const response = await fetch('/remover-livro', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id_livro: idLivro })
                });
                if (response.ok) {
                    carregarBiblioteca();
                    Swal.fire({
                        title: 'Removido',
                        text: 'Livro removido da sua biblioteca.',
                        icon: 'success',
                        confirmButtonColor: '#8b7355',
                        timer: 1500,
                        timerProgressBar: true
                    });
                }
            } catch (error) { console.error("Erro:", error); }
        }
    </script>
</body>
</html>