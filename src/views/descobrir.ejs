<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmotionBooks - Descobrir</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/descobrir.css"
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   <script src="/js/logout.js" defer></script>
</head>
<body>

    <%- include('partials/navbar', { logado: logado }) %>

    <!-- Conteúdo Principal -->
   <main class="container home-page">
        <div class="header-text">
            <h1>Encontre leituras que conversem com o seu <span class="highlight">momento</span>.</h1>
            <p>Um espaço para transformar emoções em leituras.</p>
        </div>

        <!-- Formulário e Validação -->
        <div id="mensagemErro" class="mensagem-erro"></div>

       <form action="/recomendacoes" method="GET" id="formRecomendacao">
        
            <h3 class="section-title">Como você está se sentindo agora?</h3>
            <div class="grid-cards">
                
                <div class="card-option">
                    <input type="radio" id="humor-tristeza" name="humor" value="tristeza">
                    <label for="humor-tristeza">
                        <span class="icon">😢</span>
                        <span class="title">Triste</span>
                    </label>
                </div>

                <div class="card-option">
                    <input type="radio" id="humor-ansiedade" name="humor" value="ansiedade">
                    <label for="humor-ansiedade">
                        <span class="icon">😰</span>
                        <span class="title">Ansioso</span>
                    </label>
                </div>

                <div class="card-option">
                    <input type="radio" id="humor-felicidade" name="humor" value="felicidade">
                    <label for="humor-felicidade">
                        <span class="icon">😄</span>
                        <span class="title">Feliz</span>
                    </label>
                </div>

                <div class="card-option">
                    <input type="radio" id="humor-neutro" name="humor" value="neutro">
                    <label for="humor-neutro">
                        <span class="icon">😐</span>
                        <span class="title">Neutro</span>
                    </label>
                </div>
                <div class="card-option">
    <input type="radio" id="humor-tedio" name="humor" value="tedio">
    <label for="humor-tedio">
        <span class="icon">🥱</span>
        <span class="title">Entediado</span>
    </label>
</div>

            </div>

            <hr class="section-divider">

            <h3 class="section-title">O que você busca nesta leitura?</h3>
            <div class="grid-cards grid-cards-2">
                
                <div class="card-option">
                    <input type="radio" id="intencao-manter" name="intencao" value="manter">
                    <label for="intencao-manter">
                        <span class="icon">✨</span>
                        <span class="title">Validar meu estado</span>
                        <span class="desc">Quero ler algo que combine com o que sinto agora.</span>
                    </label>
                </div>

                <div class="card-option">
                    <input type="radio" id="intencao-alterar" name="intencao" value="alterar">
                    <label for="intencao-alterar">
                        <span class="icon">🔄</span>
                        <span class="title">Transformar emoção</span>
                        <span class="desc">Quero uma leitura para mudar meu estado de espírito.</span>
                    </label>
                </div>

            </div>

            <button type="submit" class="btn-primary">Ver Recomendações</button>
        </form>
    <main>

    <!-- Menu de Acessibilidade -->
    <button class="btn-acessibilidade-flutuante" onclick="toggleMenuAcessibilidade()" title="Acessibilidade">♿</button>
    
    <div class="menu-acessibilidade" id="menuAcessibilidade">
        <h3>Navegação</h3>
        <p class="text-desc">Personalize a experiência para deixar a leitura mais confortável.</p>
        
        <div class="acessibilidade-item">
            <span>Tamanho da fonte</span>
            <div>
                <button onclick="alterarFonte(-1)">A-</button>
                <button onclick="alterarFonte(1)">A+</button>
            </div>
        </div>

        <div class="acessibilidade-item">
            <span>Alto contraste</span>
            <button onclick="toggleContraste()">Ligar/Desligar</button>
        </div>
    </div>

        <%- include('partials/footer') %>

    <script>
        // Lógica do Menu de Acessibilidade
        function toggleMenuAcessibilidade() {
            const menu = document.getElementById('menuAcessibilidade');
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
        }
        function toggleContraste() {
            document.body.classList.toggle('alto-contraste');
        }
        let tamanhoAtual = 100;
        function alterarFonte(direcao) {
            if (direcao > 0 && tamanhoAtual < 130) tamanhoAtual += 10;
            else if (direcao < 0 && tamanhoAtual > 80) tamanhoAtual -= 10;
            document.documentElement.style.fontSize = tamanhoAtual + '%';
            document.body.style.fontSize = tamanhoAtual + '%';
        }

        // Lógica de Validação do Formulário
document.getElementById('formRecomendacao').addEventListener('submit', function(e) {
    const humorSelecionado = document.querySelector('input[name="humor"]:checked');
    const intencaoSelecionada = document.querySelector('input[name="intencao"]:checked');
    const boxErro = document.getElementById('mensagemErro');
    const btnSubmit = this.querySelector('button[type="submit"]');

    // Trava de segurança: se já está carregando, ignora
    if (btnSubmit.classList.contains('carregando')) {
        e.preventDefault();
        return;
    }

    let erros = [];
    if (!humorSelecionado) erros.push("seu estado emocional atual");
    if (!intencaoSelecionada) erros.push("o que você busca nesta leitura");

    if (erros.length > 0) {
        e.preventDefault(); 
        boxErro.style.display = 'block';
        boxErro.innerHTML = '⚠️ <strong>Por favor, selecione:</strong><br>' + erros.join(' e ');
        boxErro.scrollIntoView({ behavior: 'smooth' });
    } else {
        boxErro.style.display = 'none';

        // ✅ Tudo certo → ativa o estado de carregamento
        btnSubmit.classList.add('carregando');
        btnSubmit.innerHTML = 'Buscando recomendações... <span class="spinner"></span>';
    }
});

// Se o usuário voltar pra essa página (botão "voltar" do navegador),
// garante que o botão volta ao estado normal
window.addEventListener('pageshow', function() {
    const btn = document.querySelector('#formRecomendacao button[type="submit"]');
    if (btn) {
        btn.classList.remove('carregando');
        btn.innerHTML = 'Ver Recomendações';
    }
});
      </script>
</body>
</html>