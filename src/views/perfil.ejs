<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EmotionBooks - Perfil</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/perfil.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/logout.js" defer></script>
</head>
<body>

    <%- include('partials/navbar', { logado: logado }) %>

    <div class="container perfil-wrapper">

        <!-- Cabeçalho do Perfil -->
        <div class="perfil-header">
            <div class="avatar" id="avatarSigla">--</div>
            <div class="user-info">
                <h2 id="userName">Carregando...</h2>
                <p id="userEmail">Aguarde...</p>
                <span class="insight-badge">✨ Acompanhe o seu histórico de leitura e emoções.</span>
            </div>
        </div>

        <!-- Dashboard de Números -->
        <div class="dashboard-numeros">
            <div class="stat-card">
                <span class="stat-title">📖 Lidos</span>
                <span class="stat-number" id="numLidos">0</span>
            </div>
            <div class="stat-card">
                <span class="stat-title">⏳ Quero Ler</span>
                <span class="stat-number" id="numQueroLer">0</span>
            </div>
            <div class="stat-card">
                <span class="stat-title">❤️ Favoritos</span>
                <span class="stat-number" id="numFavoritos">0</span>
            </div>
            <div class="stat-card">
                <span class="stat-title">🎭 Emoções Buscadas</span>
                <span class="stat-number" id="numEmocoes">-</span>
            </div>
        </div>

        <!-- Dashboard de Comportamento -->
        <div class="dashboard-comportamento">
            <h3>📊 Dashboard de comportamento</h3>

            <div class="comportamento-grid">
                <div class="emocao-destaque">
                    <p>Emoção mais selecionada:</p>
                    <h4 id="emocaoDestaque">Em breve</h4>
                </div>

                <div class="emocao-historico">
                    <p class="emocao-historico-titulo">Últimas buscas:</p>
                    <div id="ultimasEmocoesContainer" class="emocao-historico-tags">
                        <span class="emocao-vazia">Carregando...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico de Emoções -->
        <div class="dashboard-grafico">
            <h3>📈 Emoções mais escolhidas</h3>
            <div class="grafico-container">
                <canvas id="graficoEmocoes"></canvas>
            </div>
            <p id="graficoVazio" class="grafico-vazio">
                Sem dados suficientes ainda. Use as recomendações para gerar estatísticas!
            </p>
        </div>

        <!-- Minha Biblioteca (resumo) -->
        <div class="minha-biblioteca-resumo">
            <h3 class="biblioteca-resumo-titulo">📚 Meus Livros</h3>
            <div id="bibliotecaResumoContainer" class="biblioteca-resumo-lista">
                <p class="biblioteca-carregando">Carregando seus livros...</p>
            </div>
        </div>

    </div>

    <!-- ACESSIBILIDADE -->
    <button class="btn-acessibilidade-flutuante" onclick="toggleMenuAcessibilidade()" title="Acessibilidade" aria-label="Abrir menu de acessibilidade">♿</button>

    <div class="menu-acessibilidade" id="menuAcessibilidade" role="dialog" aria-label="Menu de acessibilidade">
        <h3>Navegação</h3>
        <p class="text-desc">Personalize a experiência para deixar a leitura mais confortável.</p>

        <div class="acessibilidade-item">
            <span>Tamanho da fonte</span>
            <div>
                <button onclick="alterarFonte(-1)" aria-label="Diminuir fonte">A-</button>
                <button onclick="alterarFonte(1)" aria-label="Aumentar fonte">A+</button>
            </div>
        </div>

        <div class="acessibilidade-item">
            <span>Alto contraste</span>
            <button onclick="toggleContraste()" aria-label="Ativar ou desativar alto contraste">Ligar/Desligar</button>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        /* =====================================
           FUNÇÕES UTILITÁRIAS
        ===================================== */
        function limparUrl(url) {
            if (!url) return '';
            if (url === 'null' || url === 'undefined') return '';
            url = url.trim();

            if (url.includes('](')) {
                const match = url.match(/\]\((.*?)\)/);
                if (match && match[1]) return match[1];
            }
            if (url.includes('(') && url.includes(')')) {
                const match = url.match(/\((.*?)\)/);
                if (match && match[1] && match[1].startsWith('http')) return match[1];
            }
            if (url.startsWith('[') && url.includes(']')) {
                const match = url.match(/\[(.*?)\]/);
                if (match && match[1] && match[1].startsWith('http')) return match[1];
            }
            if (url.startsWith('http://') || url.startsWith('https://')) return url;
            return '';
        }

        function criarCapa(url, titulo) {
            const urlLimpa = limparUrl(url);
            if (urlLimpa) {
                return `<img
                    src="${urlLimpa}"
                    alt="Capa do livro ${titulo}"
                    class="livro-capa-mini"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                >
                <div class="livro-capa-placeholder" style="display:none;">📖</div>`;
            }
            return `<div class="livro-capa-placeholder">📖</div>`;
        }

        /* =====================================
           ACESSIBILIDADE
        ===================================== */
        function toggleMenuAcessibilidade() {
            const menu = document.getElementById('menuAcessibilidade');
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }

        function toggleContraste() {
            document.body.classList.toggle('alto-contraste');
        }

        let tamanhoAtual = 100;
        function alterarFonte(direcao) {
            if (direcao > 0 && tamanhoAtual < 130) tamanhoAtual += 10;
            else if (direcao < 0 && tamanhoAtual > 80) tamanhoAtual -= 10;
            document.documentElement.style.fontSize = tamanhoAtual + '%';
            document.body.style.fontSize = tamanhoAtual + '%';
        }

        /* =====================================
           GRÁFICO DE EMOÇÕES
        ===================================== */
        function desenharGraficoEmocoes(contagem) {
            const canvas = document.getElementById('graficoEmocoes');
            const msgVazio = document.getElementById('graficoVazio');

            // Se não tem dados
            if (!contagem || Object.keys(contagem).length === 0) {
                canvas.style.display = 'none';
                msgVazio.style.display = 'block';
                return;
            }

            const cores = {
                'Felicidade': '#4CAF50',
                'Tristeza':   '#5C6BC0',
                'Ansiedade':  '#FF7043',
                'Tédio':      '#FFA726',
                'Neutro':     '#78909C'
            };

            const labels = Object.keys(contagem);
            const valores = Object.values(contagem);
            const coresGrafico = labels.map(nome => cores[nome] || '#8a6a47');

            new Chart(canvas, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: valores,
                        backgroundColor: coresGrafico,
                        borderColor: '#ffffff',
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: 'Poppins', size: 13 },
                                padding: 16,
                                usePointStyle: true
                            }
                        }
                    }
                }
            });
        }

        /* =====================================
           CARREGAR PERFIL
        ===================================== */
        window.addEventListener('DOMContentLoaded', async () => {
            try {
                const response = await fetch('/minha-biblioteca');

                if (response.status === 401) {
                    window.location.href = '/login';
                    return;
                }

                const data = await response.json();

                // 1. Dados do usuário
                document.getElementById('userName').innerText = data.usuario.nome;
                document.getElementById('userEmail').innerText = data.usuario.email;
                document.getElementById('avatarSigla').innerText = data.usuario.nome.charAt(0).toUpperCase();

                // 2. Estatísticas de livros
                const livros = data.livros;
                let contLidos = 0, contQueroLer = 0, contFavoritos = 0;

                livros.forEach(livro => {
                    if (livro.status_leitura === 'Lido') contLidos++;
                    if (livro.status_leitura === 'Quero ler') contQueroLer++;
                    if (livro.favorito === 1) contFavoritos++;
                });

                document.getElementById('numLidos').innerText = contLidos;
                document.getElementById('numQueroLer').innerText = contQueroLer;
                document.getElementById('numFavoritos').innerText = contFavoritos;

                // 3. Estatísticas de emoções
                if (data.emocoes) {
                    document.getElementById('numEmocoes').innerText = data.emocoes.total;
                    document.getElementById('emocaoDestaque').innerText = data.emocoes.maisFrequente;

                    // Tags das últimas emoções
                    const ultimasContainer = document.getElementById('ultimasEmocoesContainer');
                    ultimasContainer.innerHTML = '';

                    if (data.emocoes.ultimas && data.emocoes.ultimas.length > 0) {
                        const coresEmocoes = {
                            'Felicidade': '#4CAF50',
                            'Tristeza':   '#5C6BC0',
                            'Ansiedade':  '#FF7043',
                            'Tédio':      '#FFA726',
                            'Neutro':     '#78909C'
                        };

                        data.emocoes.ultimas.forEach(emocao => {
                            const tag = document.createElement('span');
                            tag.className = 'tag-pill';
                            tag.style.backgroundColor = coresEmocoes[emocao] || '#4a4038';
                            tag.innerText = emocao;
                            ultimasContainer.appendChild(tag);
                        });
                    } else {
                        ultimasContainer.innerHTML = '<span class="emocao-vazia">Nenhuma busca ainda.</span>';
                    }

                    // Gráfico
                    desenharGraficoEmocoes(data.emocoes.contagem);
                }

                // 4. Resumo da biblioteca
                const bibliotecaContainer = document.getElementById('bibliotecaResumoContainer');
                bibliotecaContainer.innerHTML = '';

                if (livros.length === 0) {
                    bibliotecaContainer.innerHTML = `
                        <div class="biblioteca-vazia">
                            <p>Sua biblioteca está vazia. Busque recomendações!</p>
                            <a href="/">← Voltar ao início</a>
                        </div>
                    `;
                } else {
                    const livrosResumo = livros.slice(0, 5);

                    livrosResumo.forEach(livro => {
                        const div = document.createElement('div');
                        div.className = 'livro-resumo-item';

                        const statusIcon = livro.status_leitura === 'Lido' ? '📖' : '⏳';
                        const statusCor = livro.status_leitura === 'Lido' ? '#2d6a4f' : '#6b5f55';

                        div.innerHTML = `
                            ${criarCapa(livro.capa_url, livro.titulo)}
                            <div class="livro-resumo-info">
                                <h4>${livro.titulo}</h4>
                                <p>${livro.autor}</p>
                            </div>
                            <span class="livro-resumo-status" style="background: ${statusCor}15; color: ${statusCor};">
                                ${statusIcon} ${livro.status_leitura}
                            </span>
                            ${livro.favorito === 1 ? '<span class="livro-resumo-fav">❤️</span>' : ''}
                        `;

                        bibliotecaContainer.appendChild(div);
                    });

                    if (livros.length > 5) {
                        const verTodos = document.createElement('div');
                        verTodos.className = 'biblioteca-ver-todos';
                        verTodos.innerHTML = `
                            <a href="/biblioteca">
                                Ver todos os ${livros.length} livros →
                            </a>
                        `;
                        bibliotecaContainer.appendChild(verTodos);
                    }
                }

            } catch (error) {
                console.error("Erro ao carregar o perfil:", error);
                document.getElementById('userName').innerText = "Erro ao carregar dados";
                document.getElementById('bibliotecaResumoContainer').innerHTML = `
                    <div class="biblioteca-erro">
                        <p>Erro ao carregar seus livros. Tente novamente.</p>
                    </div>
                `;
            }
        });
    </script>
</body>
</html>